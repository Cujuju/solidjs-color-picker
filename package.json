{
  "name": "@cujuju/solidjs-color-picker",
  "version": "0.3.0",
  "description": "TradingView-style color picker for SolidJS — canvas-based HSV controls, palette grid, alpha support, EyeDropper API, zero dependencies.",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "solid": "./src/utils.ts",
      "import": "./dist/utils.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Cujuju",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cujuju/solidjs-color-picker.git"
  },
  "homepage": "https://github.com/Cujuju/solidjs-color-picker#readme",
  "bugs": "https://github.com/Cujuju/solidjs-color-picker/issues",
  "keywords": [
    "solidjs",
    "solid",
    "color-picker",
    "tradingview",
    "hsv",
    "canvas",
    "palette"
  ],
  "peerDependencies": {
    "solid-js": ">=1.7.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vite-plugin-solid": "^2.11.12"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepublishOnly": "vite build"
  },
  "publishConfig": {
    "access": "public"
  }
}
